{
  "name": "canvue",
  "version": "0.1.0",
  "description": "Vue3 label designer component — design grid-based labels and print them",
  "type": "module",
  "main": "./dist/canvue.cjs",
  "module": "./dist/canvue.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/canvue.mjs",
      "require": "./dist/canvue.cjs"
    },
    "./style.css": "./dist/canvue.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --mode playground",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build",
    "preview": "vite preview --mode playground",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.2.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "jsbarcode": "^3.11.6",
    "qrcode": "^1.5.3"
  },
  "keywords": [
    "vue3",
    "label",
    "designer",
    "barcode",
    "print",
    "drag-and-drop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TBD/canvue"
  },
  "homepage": "https://github.com/TBD/canvue#readme",
  "bugs": {
    "url": "https://github.com/TBD/canvue/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
